# SITE_LT_DASHBOARD_USER=your_dashboard_username
# SITE_LT_DASHBOARD_PASS=your_dashboard_password
# SITE_LT_DASHBOARD_TOTP=your_totp_base32_secret
# 後台（自動化代理帳號，限定權限：管理 + 報表）
# SITE_LT_DASHBOARD_AGENT_USER=your_agent_username
# SITE_LT_DASHBOARD_AGENT_PASS=your_agent_password
# SITE_LT_DASHBOARD_AGENT_TOTP=your_totp_base32_secret
