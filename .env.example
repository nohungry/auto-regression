# =============================================
# 多站點設定範本 - 複製此檔案為 .env 並填入實際值
# =============================================

# 預設執行站點（執行 pytest 時若未指定 --site 則用此值）
DEFAULT_SITE=rc

# -----------------------------------------------
# 執行環境說明
# -----------------------------------------------
# Windows：Playwright 直接啟動 Chrome，不需要任何手動操作
# WSL：自動啟動 Windows Chrome（需設定正確的 CDP_URL）
#   CDP_URL 填 Windows host IP（通常為 172.x.x.x），可用 `cat /etc/resolv.conf` 查詢
# 純 Linux：需手動啟動 Chrome 並設定 CDP_URL

# 是否無頭模式（Windows 適用，預設 false 會顯示瀏覽器視窗）
HEADLESS=false

# CDP 連線位址（WSL / 純 Linux 環境需要設定，Windows 不需要）
# Port 固定 9223（專案規定）；IP 依機器不同
# WSL 範例：CDP_URL=http://<WINDOWS_HOST_IP>:9223
CDP_URL=http://<WINDOWS_HOST_IP>:9223

# -----------------------------------------------
# 站點設定格式（每站 13 個 keys）
# -----------------------------------------------
#
# 【前台】
# SITE_<ID>_URL              — 前台網址
# SITE_<ID>_USERNAME         — 前台測試帳號
# SITE_<ID>_PASSWORD         — 前台測試密碼
#
# 【後台】
# SITE_<ID>_DASHBOARD_URL          — 站長後台入口（網址含 -admin，如 dev-XX-admin-dashboard）
# SITE_<ID>_DASHBOARD_AGENT_URL    — 代理後台入口（網址不含 -admin，如 dev-XX-dashboard），搭配 AGENT 帳號使用
# SITE_<ID>_DASHBOARD_USER         — 後台管理帳號（總代）
# SITE_<ID>_DASHBOARD_PASS         — 後台管理密碼
# SITE_<ID>_DASHBOARD_TOTP         — 後台 TOTP secret（Google Authenticator base32 金鑰）
# SITE_<ID>_DASHBOARD_AGENT_USER   — 後台自動化代理帳號（限定管理/報表權限，用於存入提取測試）
# SITE_<ID>_DASHBOARD_AGENT_PASS   — 後台自動化代理密碼
# SITE_<ID>_DASHBOARD_AGENT_TOTP   — 後台代理 TOTP secret（代理啟用 2FA 才需，否則留空）
#
# 【API】
# SITE_<ID>_API_URL          — API base URL（API 測試用）
# SITE_<ID>_API_DOMAIN       — API origin domain（API 測試用）
# SITE_<ID>_COMPANYCODE      — 後端 API companycode（若與 site_id 不同時需設定，
#                               例如站點 rename 後 site_id=rc 但 API 仍需送 drc）

# -----------------------------------------------
# 王老吉站點 (rc) — 信用版
# -----------------------------------------------
# 前台
SITE_RC_URL=https://<your-rc-domain>/
SITE_RC_USERNAME=your_username
SITE_RC_PASSWORD=your_password
# 後台（總代帳號 / 站長+代理皆可登入）
SITE_RC_DASHBOARD_URL=https://<your-rc-admin-dashboard-domain>/
# 後台（僅代理入口，無 -admin）
SITE_RC_DASHBOARD_AGENT_URL=https://<your-rc-dashboard-domain>/
SITE_RC_DASHBOARD_USER=your_dashboard_username
SITE_RC_DASHBOARD_PASS=your_dashboard_password
SITE_RC_DASHBOARD_TOTP=your_totp_base32_secret
# 後台（自動化代理帳號，限定權限：管理 + 報表）
SITE_RC_DASHBOARD_AGENT_USER=your_agent_username
SITE_RC_DASHBOARD_AGENT_PASS=your_agent_password
SITE_RC_DASHBOARD_AGENT_TOTP=your_totp_base32_secret
# API
SITE_RC_API_URL=https://<your-api-domain>
SITE_RC_API_DOMAIN=<your-rc-api-domain>
SITE_RC_COMPANYCODE=drc

# -----------------------------------------------
# LT來財站點 (lt) — 信用版
# -----------------------------------------------
# 前台
# SITE_LT_URL=https://<your-lt-domain>/
# SITE_LT_USERNAME=your_username
# SITE_LT_PASSWORD=your_password
# 後台（總代帳號 / 站長+代理皆可登入）
# SITE_LT_DASHBOARD_URL=https://<your-lt-admin-dashboard-domain>/
# 後台（僅代理入口，無 -admin）
