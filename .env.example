# =============================================
# 多站點設定範本 - 複製此檔案為 .env 並填入實際值
# =============================================

# 預設執行站點（執行 pytest 時若未指定 --site 則用此值）
DEFAULT_SITE=drc

# -----------------------------------------------
# 執行環境說明
# -----------------------------------------------
# Windows：Playwright 直接啟動 Chrome，不需要任何手動操作
# WSL：自動啟動 Windows Chrome（需設定正確的 CDP_URL）
#   CDP_URL 填 Windows host IP（通常為 172.x.x.x），可用 `cat /etc/resolv.conf` 查詢
# 純 Linux：需手動啟動 Chrome 並設定 CDP_URL

# 是否無頭模式（Windows 適用，預設 false 會顯示瀏覽器視窗）
HEADLESS=false

# CDP 連線位址（WSL / 純 Linux 環境需要設定，Windows 不需要）
# WSL 範例：CDP_URL=http://<WINDOWS_HOST_IP>:9223
CDP_URL=http://<WINDOWS_HOST_IP>:9223

# -----------------------------------------------
# 站點設定格式
# -----------------------------------------------
# SITE_<ID>_URL            — 前台網址
# SITE_<ID>_DASHBOARD_URL  — 後台管理介面網址
# SITE_<ID>_USERNAME        — 測試帳號
# SITE_<ID>_PASSWORD        — 測試密碼
# SITE_<ID>_API_URL         — API base URL（API 測試用）
# SITE_<ID>_API_DOMAIN      — API origin domain（API 測試用）

# -----------------------------------------------
# 站點一 (drc) — 前台 + 後台
# -----------------------------------------------
SITE_DRC_URL=https://<your-drc-domain>/
SITE_DRC_DASHBOARD_URL=https://<your-drc-dashboard-domain>/
SITE_DRC_USERNAME=your_username
SITE_DRC_PASSWORD=your_password
# SITE_DRC_API_URL=https://<your-api-domain>
# SITE_DRC_API_DOMAIN=<your-drc-api-domain>

# -----------------------------------------------
# 站點二 (dlt) — 前台 + 後台
# -----------------------------------------------
# SITE_DLT_URL=https://<your-dlt-domain>/
# SITE_DLT_DASHBOARD_URL=https://<your-dlt-dashboard-domain>/
# SITE_DLT_USERNAME=your_username
# SITE_DLT_PASSWORD=your_password
# SITE_DLT_API_URL=https://<your-api-domain>
# SITE_DLT_API_DOMAIN=<your-dlt-api-domain>

# -----------------------------------------------
# 其他站點（取消註解並填入實際值即可啟用）
# 支援站點 ID：CG, JI, KS, LG, LU, QW, RD, RE, RF, UA
# -----------------------------------------------

# --- CG ---
# SITE_CG_URL=https://<your-cg-domain>/
# SITE_CG_DASHBOARD_URL=https://<your-cg-dashboard-domain>/
# SITE_CG_USERNAME=your_username
# SITE_CG_PASSWORD=your_password

# --- JI ---
# SITE_JI_URL=https://<your-ji-domain>/
# SITE_JI_DASHBOARD_URL=https://<your-ji-dashboard-domain>/
# SITE_JI_USERNAME=your_username
# SITE_JI_PASSWORD=your_password

# --- KS ---
# SITE_KS_URL=https://<your-ks-domain>/
# SITE_KS_DASHBOARD_URL=https://<your-ks-dashboard-domain>/
# SITE_KS_USERNAME=your_username
# SITE_KS_PASSWORD=your_password

# --- LG ---
# SITE_LG_URL=https://<your-lg-domain>/
# SITE_LG_DASHBOARD_URL=https://<your-lg-dashboard-domain>/
# SITE_LG_USERNAME=your_username
# SITE_LG_PASSWORD=your_password

# --- LU ---
# SITE_LU_URL=https://<your-lu-domain>/
# SITE_LU_DASHBOARD_URL=https://<your-lu-dashboard-domain>/
# SITE_LU_USERNAME=your_username
# SITE_LU_PASSWORD=your_password

# --- QW ---
# SITE_QW_URL=https://<your-qw-domain>/
# SITE_QW_DASHBOARD_URL=https://<your-qw-dashboard-domain>/
# SITE_QW_USERNAME=your_username
# SITE_QW_PASSWORD=your_password

# --- RD ---
# SITE_RD_URL=https://<your-rd-domain>/
# SITE_RD_DASHBOARD_URL=https://<your-rd-dashboard-domain>/
# SITE_RD_USERNAME=your_username
# SITE_RD_PASSWORD=your_password

# --- RE ---
# SITE_RE_URL=https://<your-re-domain>/
# SITE_RE_DASHBOARD_URL=https://<your-re-dashboard-domain>/
# SITE_RE_USERNAME=your_username
# SITE_RE_PASSWORD=your_password

# --- RF ---
# SITE_RF_URL=https://<your-rf-domain>/
