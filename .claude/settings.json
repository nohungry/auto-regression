{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .github/scripts/check-docs-sync.sh"
          },
          {
            "type": "command",
            "command": "bash .github/scripts/check-commit-msg.sh"
          },
          {
            "type": "command",
            "command": "bash .github/scripts/check-factory-import.sh"
          }
        ]
      }
    ]
  }
}
