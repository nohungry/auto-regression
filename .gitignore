# 敏感資料 - 絕對不能進 git
.env

# Playwright
test-results/
playwright-report/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Reports (test run artifacts, runtime logs)
reports/

# Screenshots (test run artifacts)
screenshots/

# Layout fingerprint diff output (written on comparison failure; transient)
**/__fingerprints__/*.actual.json

# VS Code (machine-specific settings)
.vscode/

# MCP config (contains machine-specific Windows host IP)
.mcp.json

# Playwright MCP runtime logs
.playwright-mcp/

# Dev notes (personal scratch area, not shipped)
dev-notes/*
!dev-notes/README.md

# Claude Code — 只追蹤 skills（團隊共用）
.claude/*
!.claude/skills/
.claude/skills/playwright-pro/

# Python virtual environment
.venv/
